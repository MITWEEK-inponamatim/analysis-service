FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
RUN useradd --create-home --uid 10001 app && mkdir /ms-playwright && chown app:app /ms-playwright
COPY requirements.browser.txt .
RUN pip install --no-cache-dir --retries 10 --timeout 120 -r requirements.browser.txt \
    && playwright install --with-deps chromium \
    && chown -R app:app /ms-playwright
COPY app ./app
USER app
CMD ["python", "-m", "app.run_browser_worker"]
