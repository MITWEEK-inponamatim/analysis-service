FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TMPDIR=/tmp HOME=/tmp MPLCONFIGDIR=/tmp/mpl JAVA_TOOL_OPTIONS=-Duser.home=/tmp

# Install jadx for APK decompilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget unzip openjdk-21-jre-headless libyara-dev \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q https://github.com/skylot/jadx/releases/download/v1.5.0/jadx-1.5.0.zip -O /tmp/jadx.zip \
    && unzip -q /tmp/jadx.zip -d /opt/jadx \
    && chmod +x /opt/jadx/bin/jadx \
    && rm /tmp/jadx.zip

ENV PATH="/opt/jadx/bin:${PATH}"

WORKDIR /app
RUN useradd --create-home --uid 10001 app
COPY requirements.worker.txt .
RUN pip install --no-cache-dir --retries 10 --timeout 120 -r requirements.worker.txt
COPY app ./app
USER app
CMD ["uvicorn", "app.file_worker:app", "--host", "0.0.0.0", "--port", "8003"]
