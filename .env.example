SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
DATABASE_URL=
DATABASE_URL_SESSION=
BROWSER_WORKER_URL=http://browser-gateway:8002
FILE_WORKER_URL=http://analysis-worker:8003
SERVICE_API_KEY=replace-with-the-same-random-value-in-backend

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-luna
# Set for an OpenAI-compatible gateway if this model is not on OpenAI directly.
OPENAI_BASE_URL=
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=2

SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
EXA_API_KEY=

# Optional external services. Leave empty to run without them; scans then record the
# corresponding entry in risk.coverage.checks_unavailable instead of failing.
MOBSF_URL=
MOBSF_API_KEY=
MOBSF_TIMEOUT_SECONDS=120

# Dynamic APK analysis needs an operator-provided sandbox (no emulator ships with ThreatLens).
DYNAMIC_ANALYSIS_URL=
DYNAMIC_ANALYSIS_API_KEY=
DYNAMIC_ANALYSIS_TIMEOUT_SECONDS=180

# Agent / LLM behaviour
OPENAI_VISION_MODEL=
VISION_MAX_MB=4
AGENT_TOOL_ROUNDS=2
AGENT_MAX_TOOL_CALLS=6
EXTERNAL_RETRY_ATTEMPTS=3
MAX_CONCURRENT_JOBS=4
LOG_LEVEL=INFO

# File retention job (analysis-service background task + POST /internal/v1/maintenance/retention)
RETENTION_ENABLED=true
RETENTION_INTERVAL_SECONDS=3600

# Phase 3 scanners
MAX_UPLOAD_MB=50
MAX_IMAGE_MB=15
MAX_DOWNLOAD_MB=60
OCR_LANGUAGES=ind+eng
OCR_TIMEOUT_SECONDS=20
FILE_WORKER_TIMEOUT_SECONDS=
IMAGE_URL_SCAN_LIMIT=2
IMAGE_URL_SCAN_TIMEOUT_SECONDS=35
MESSAGE_URL_SCAN_LIMIT=2
MAX_APK_ENTRIES=20000
MAX_APK_UNCOMPRESSED_MB=500
MAX_APK_ENTRY_MB=100
MAX_APK_COMPRESSION_RATIO=200
FILE_RETENTION_DAYS=7
